{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dm.family/fact",
  "title": "fact",
  "description": "系统层交给角色层的事实载荷。角色层只能用这些事实说话，不得增删数字。",
  "type": "object",
  "required": ["kind", "status"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "fact" },
    "status": { "enum": ["ok", "unavailable", "denied", "error", "notfound", "not_needed", "approval_required"] },
    "facts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["text", "source"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "maxLength": 200 },
          "source": { "type": "string" },
          "ttl_s": { "type": "integer", "minimum": 0 },
          "standalone": { "type": "boolean" }
        }
      }
    },
    "note": { "type": "string", "maxLength": 200 },
    "action": { "type": "string", "maxLength": 40 },
    "args": { "type": "object" }
  }
}