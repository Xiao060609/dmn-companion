{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dm.family/frame",
  "title": "frame",
  "description": "系统层告诉角色层『这一轮要传达什么』。只给约束，不给台词。",
  "type": "object",
  "required": ["kind", "intent", "max_sentences"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "frame" },
    "intent": { "enum": ["answer", "comfort", "ask_back", "refuse", "ack"] },
    "must_include": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
    "must_not_claim": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
    "must_not_mention": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
    "max_sentences": { "type": "integer", "minimum": 1, "maximum": 5 },
    "style": { "type": "string", "maxLength": 120 },
    "fallback_phrasing": { "type": "string", "maxLength": 200 }
  }
}